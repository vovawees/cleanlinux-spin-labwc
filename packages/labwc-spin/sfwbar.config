#Api2
# The panel of the labwc spin, for users without ~/.config/sfwbar/sfwbar.config (labwc-spin panel):
# copy this file there to change it. The widgets are sfwbar's own (/usr/share/sfwbar/*.widget); a
# block after a widget sets its variables. Colours: the dark Adwaita of GTK; icons: the CleanLinux
# theme (/etc/gtk-3.0/settings.ini). sfwbar(1): every option.

Theme = "Adwaita-dark"
Set ThicknessHint = "32px"

# new windows: a cascade from the upper left corner
placer {
  xorigin = 5
  yorigin = 5
  xstep = 4
  ystep = 4
  children = true
}

# the menu of a window button (minimise, maximise, close)
include "winops.widget"

bar {
  edge = "bottom"
  layer = "top"
  mirror = "*"
  exclusive_zone = "auto"

  # the programs of /usr/share/applications by category
  widget "startmenu.widget" {
    icon = "cleanlinux-start"
  }
  widget "showdesktop.widget"

  taskbar {
    style = "taskbar"
    rows = 1
    icons = true
    labels = true
    tooltips = true
    sort = false
    action[RightClick] = Menu("winops")
    action[Drag] = Focus()
  }

  # the free space between the windows and the indicators
  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }

  tray {
    rows = 1
  }

  button {
    value = "input-keyboard-symbolic"
    style = "keyboard"
    class = "module"
    tooltip = "On-screen keyboard (Super+K)"
    action = Exec("labwc-spin keyboard")
  }

  # the notification centre: the notification server of the desktop
  widget "ncenter.widget"
  widget "bluez.widget"
  widget "network.widget"
  widget "volume.widget" {
    simple_icon = true
    volume_thresholds = [67, 34, 0]
    volume_icons = ["audio-volume-high", "audio-volume-medium", "audio-volume-low"]
    volume_muted = "audio-volume-muted"
  }
  widget "backlight.widget" {
    step = 5
    min_brightness = 10
    max_brightness = 100
  }
  widget "battery.widget" {
    simple_icon = true
  }
  widget "language.widget"
  widget "clock.widget" {
    time_format = "%H:%M"
    tooltip_format = "%A %x"
    week_starts_on_sunday = false
    reset_on_popup = true
  }
  # session actions: [icon, title, command]; elogind lets the user of the screen power off
  widget "session.widget" {
    session_actions = [
      ["system-lock-screen", "Lock", "labwc-spin lock"],
      ["system-log-out", "Log out", "labwc --exit"],
      ["weather-clear-night", "Suspend", "loginctl suspend"],
      ["system-reboot", "Reboot", "loginctl reboot"],
      ["system-shutdown", "Power off", "loginctl poweroff"]
    ]
  }
}

#CSS

#hidden {
  -GtkWidget-visible: false;
}

window#sfwbar {
  background-color: alpha(@theme_bg_color, 0.94);
}

button,
button image {
  min-height: 0px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
}

label {
  font-family: "DejaVu Sans";
  font-size: calc(@bar_thickness * 0.42);
}

image {
  -ScaleImage-symbolic: true;
}

.module,
button#startmenu {
  border: none;
  border-radius: 6px;
  margin: 0px 1px;
  padding: calc(@bar_thickness * 0.14);
  -GtkWidget-vexpand: true;
}

.module:hover,
button#startmenu:hover,
button#taskbar_item:hover {
  background-color: alpha(@theme_fg_color, 0.12);
}

.module image,
button#startmenu image {
  min-width: calc(@bar_thickness * 0.62);
  min-height: calc(@bar_thickness * 0.62);
  padding: 0px;
  margin: 0px;
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
  color: @theme_fg_color;
}

button#startmenu image {
  -ScaleImage-symbolic: false;
  min-width: calc(@bar_thickness * 0.72);
  min-height: calc(@bar_thickness * 0.72);
}

button#taskbar_item {
  border: none;
  border-radius: 6px;
  margin: 2px 1px;
  padding: 0px calc(@bar_thickness * 0.2);
  -GtkWidget-hexpand: false;
}

button#taskbar_item.focused {
  background-color: alpha(@theme_selected_bg_color, 0.5);
}

button#taskbar_item.minimized label {
  color: alpha(currentColor, 0.6);
}

button#taskbar_item image {
  min-width: calc(@bar_thickness * 0.6);
  min-height: calc(@bar_thickness * 0.6);
  padding-right: calc(@bar_thickness * 0.2);
  -ScaleImage-symbolic: false;
  -GtkWidget-vexpand: true;
}

button#tray_item {
  margin: 0px;
  border: none;
  padding: 0px 2px;
}

button#tray_item.passive {
  -GtkWidget-visible: false;
}

button#tray_item image {
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
  padding: 4px;
}

label#clock,
label#language {
  padding: 0px 6px;
}

#menu_item,
#menu_item image,
#menu_item label {
  -GtkWidget-halign: start;
}

#app_menu_system #menu_item image {
  -ScaleImage-symbolic: false;
}

menuitem image {
  min-width: 20px;
  min-height: 20px;
  padding-right: 6px;
}
