# labwc and sfwbar read /etc/xdg after the user's ~/.config; edits of the system copies survive updates
backup=(etc/xdg/labwc/rc.xml etc/xdg/labwc/menu.xml etc/xdg/labwc/environment etc/xdg/labwc/autostart
	etc/xdg/sfwbar/sfwbar.config etc/gtk-3.0/settings.ini)

do_build() {
	python3 "$FILES/wallpaper.py" cleanlinux.png 1920 1080
}

do_install() {
	local f
	install -Dm755 "$FILES/labwc-spin" "$DESTDIR/usr/bin/labwc-spin"
	for f in rc.xml menu.xml environment autostart; do
		install -Dm644 "$FILES/$f" "$DESTDIR/etc/xdg/labwc/$f"
	done
	install -Dm644 "$FILES/sfwbar.config" "$DESTDIR/etc/xdg/sfwbar/sfwbar.config"
	install -Dm644 "$FILES/gtk-settings.ini" "$DESTDIR/etc/gtk-3.0/settings.ini"
	install -Dm644 "$FILES/labwc-spin.sh" "$DESTDIR/etc/profile.d/labwc-spin.sh"
	install -Dm644 -t "$DESTDIR/usr/share/applications" "$FILES"/labwc-spin-*.desktop
	install -Dm644 cleanlinux.png "$DESTDIR/usr/share/backgrounds/cleanlinux/default.png"
}
