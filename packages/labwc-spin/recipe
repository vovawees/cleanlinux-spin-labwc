# labwc reads /etc/xdg/labwc after ~/.config/labwc; edits of the system copies survive updates
backup=(etc/xdg/labwc/rc.xml etc/xdg/labwc/menu.xml etc/xdg/labwc/environment)

do_install() {
	local f
	for f in rc.xml menu.xml environment; do
		install -Dm644 "$FILES/$f" "$DESTDIR/etc/xdg/labwc/$f"
	done
	install -Dm644 "$FILES/labwc-spin.sh" "$DESTDIR/etc/profile.d/labwc-spin.sh"
}
