name=labwc-spin
version=2
release=1
summary="Settings of the labwc spin: labwc, the panel, the session helpers, the wallpaper, the desktop at login"
homepage=https://github.com/vovawees/cleanlinux-spin-labwc
license=(MIT)
category=extra
# labwc-spin (/usr/bin): what the settings files cannot do: the desktop at the login on tty1 with
# the keyboard layout of the console, the scale of high-DPI screens, the rotation by the
# accelerometer, the on-screen keyboard, the lock, screenshots, the installer of the live system.
# /etc/xdg: labwc (rc.xml, menu.xml, environment, autostart) and the panel (sfwbar.config); GTK:
# the CleanLinux icons. The wallpaper is drawn during the build (python3 of the build machine)
depends=(bash procps-ng coreutils labwc foot dejavu-fonts sfwbar swaybg swaylock swayidle grim slurp
	wl-clipboard brightnessctl wlr-randr wvkbd iio-sensor-proxy wireplumber dbus glib cleanlinux-icon-theme
	gdk-pixbuf-nanosvg)
build_type=custom
source=(labwc-spin rc.xml menu.xml environment autostart sfwbar.config
	gtk-settings.ini labwc-spin.sh labwc-spin-keyboard.desktop labwc-spin-screenshot.desktop wallpaper.py)
