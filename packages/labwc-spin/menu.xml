<?xml version="1.0" encoding="UTF-8"?>
<!-- the root menu (a click on the desktop) of the labwc spin; ~/.config/labwc/menu.xml replaces it -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Terminal">
      <action name="Execute" command="foot" />
    </item>
    <separator />
    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>
    <item label="Exit">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
