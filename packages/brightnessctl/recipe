name=brightnessctl
version=0.5.1
release=1
summary="brightnessctl: screen backlight and LED brightness for the users of the group video (udev rule)"
homepage=https://github.com/Hummer12007/brightnessctl
license=(MIT)
category=extra
depends=(glibc)
build_type=make
source=(brightnessctl-$version.tar.gz::https://github.com/Hummer12007/brightnessctl/archive/refs/tags/$version.tar.gz)
sha256=(a68869e23f56ac4f2e28f1783002810ddbf10f95e1af9b48b2912fb169f46994)
# no setuid: the udev rule gives the group video write access to /sys/class/backlight and leds
make_args=(INSTALL_UDEV_RULES=1 UDEVDIR=/usr/lib/udev/rules.d)
