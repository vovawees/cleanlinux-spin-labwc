name=wlroots
version=0.20.2
release=1
summary="wlroots: modular Wayland compositor library (DRM/KMS, libinput, GLES2 and pixman renderers)"
homepage=https://gitlab.freedesktop.org/wlroots/wlroots
license=(MIT)
category=extra
# sessions through libseat (seatd); no Xwayland (the spin is Wayland only), no Vulkan renderer,
# no color management (lcms2) and no libliftoff: none of them is in the base yet
depends=(glibc wayland libdrm libxkbcommon pixman libinput seatd eudev libdisplay-info mesa)
makedepends=(wayland-protocols hwdata)
build_type=meson
source=(https://gitlab.freedesktop.org/-/project/12103/uploads/6a56af9eafb5240d2823772aeb1e2e7d/wlroots-$version.tar.gz)
sha256=(80c567d2ed4efb2cfa6b077f22c7a710d9c78ba4e185a75e8694001114af0733)
meson_args=(-Dxwayland=disabled -Dxcb-errors=disabled -Dexamples=false -Drenderers=gles2
	-Dbackends=drm,libinput -Dallocators=gbm,udmabuf -Dsession=enabled -Dcolor-management=disabled
	-Dlibliftoff=disabled)
