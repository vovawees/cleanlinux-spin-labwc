+/*
+ * A touch screen reports [0, 1] coordinates of the panel as it is mounted,
+ * the output shows its picture turned by its transform (rc.xml, wlr-randr,
+ * the panel orientation): the touches are turned the same way (buffer to
+ * output coordinates, as wlr_box_transform), so that they land where the
+ * picture is, also after a rotation.
+ */
+static void
+touch_transform(struct wlr_touch *touch, double *x, double *y)
+{
+	struct wlr_output *output = seat_touch_output(touch);
+	if (!output || isnan(*x) || isnan(*y)) {
+		return;
+	}
+	double u = *x, v = *y;
+	switch (output->transform) {
+	case WL_OUTPUT_TRANSFORM_NORMAL:
+		break;
+	case WL_OUTPUT_TRANSFORM_90:
+		*x = 1.0 - v;
+		*y = u;
+		break;
+	case WL_OUTPUT_TRANSFORM_180:
+		*x = 1.0 - u;
+		*y = 1.0 - v;
+		break;
+	case WL_OUTPUT_TRANSFORM_270:
+		*x = v;
+		*y = 1.0 - u;
+		break;
+	case WL_OUTPUT_TRANSFORM_FLIPPED:
+		*x = 1.0 - u;
+		break;
+	case WL_OUTPUT_TRANSFORM_FLIPPED_90:
+		*x = v;
+		*y = u;
+		break;
+	case WL_OUTPUT_TRANSFORM_FLIPPED_180:
+		*y = 1.0 - v;
+		break;
+	case WL_OUTPUT_TRANSFORM_FLIPPED_270:
+		*x = 1.0 - v;
+		*y = 1.0 - u;
+		break;
+	}
+}
