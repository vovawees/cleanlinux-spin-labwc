+/*
+ * The built-in screen (eDP, LVDS, DSI) when there is exactly one: a touch
+ * screen without mapToOutput (rc.xml) or WL_OUTPUT (udev) goes to it, as in
+ * sway, so touches follow its rotation and an external monitor does not
+ * stretch them. A handheld or tablet with a monitor attached keeps working.
+ */
+static char *
+builtin_output_name(void)
+{
+	struct output *output;
+	char *found = NULL;
+	wl_list_for_each(output, &server.outputs, link) {
+		char *name = output->wlr_output->name;
+		if (!strncmp(name, "eDP-", 4) || !strncmp(name, "LVDS-", 5)
+				|| !strncmp(name, "DSI-", 4)) {
+			if (found) {
+				return NULL;
+			}
+			found = name;
+		}
+	}
+	return found;
+}
