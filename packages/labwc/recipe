name=labwc
version=0.20.3
release=1
summary="labwc: a window-stacking Wayland compositor inspired by Openbox (wlroots)"
homepage=https://labwc.github.io/
license=(GPL-2.0-only)
category=extra
features=(+nls)
# no Xwayland, no SVG (librsvg) and icon (libsfdo) support, no man pages (scdoc)
depends=(glibc wlroots wayland libxkbcommon libxml2 glib cairo pango libinput pixman libpng libdrm)
makedepends=(wayland-protocols)
build_type=meson
source=(labwc-$version.tar.gz::https://github.com/labwc/labwc/archive/refs/tags/$version.tar.gz)
sha256=(1e70a5b74f149c5b47da76063dbdf967c44b2d7b6e94d3fdf65f70fc252f65c9)
meson_args=(-Dxwayland=disabled -Dsvg=disabled -Dicon=disabled -Dman-pages=disabled -Dlabnag=enabled
	-Dsystemd-session=disabled -Dtest=disabled -Dstatic_analyzer=disabled)
meson_extra() { meson_feature nls; }
